# SNAT Manager Docker Compose 配置示例
# 复制为 .env 后，把下面三个占位值替换为强随机值：
#   cp .env.example .env
#   openssl rand -hex 32

SNAT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SNAT_TOKEN_SECRET=replace-with-64-random-hex-characters-DO-NOT-USE
AGENT_TOKEN=replace-with-64-random-hex-characters-DO-NOT-USE

# 可选：固定 Flask 会话密钥；留空时由 Web 容器在持久卷中自动生成。
SNAT_SECRET_KEY=

# Web 默认只监听宿主机 127.0.0.1:5000，由 Nginx/Caddy 提供 HTTPS。
SNAT_WEB_BIND=5000
FORCE_HTTPS=0
TRUST_PROXY=0
WEB_HOST=0.0.0.0

# Agent 推荐绑定 WireGuard/内网 IP；公网直连时务必设置来源白名单。
AGENT_HOST=127.0.0.1
AGENT_PORT=8888
AGENT_ALLOW_BEARER=0
AGENT_ALLOWED_IPS=
