FROM python:3.11-slim

WORKDIR /app

# iptables 用于实际下发规则；conntrack 用于活跃连接统计（可选但建议）
RUN apt-get update \
    && apt-get install -y --no-install-recommends iptables conntrack \
    && rm -rf /var/lib/apt/lists/*

# 固定依赖版本，保证可复现构建（Agent 仅需 flask + werkzeug + gunicorn）
RUN pip install --no-cache-dir flask==3.1.3 Werkzeug==3.1.7 gunicorn==23.0.0

COPY agent /app

ENV DNS_REFRESH_INTERVAL=60 AGENT_HOST=127.0.0.1 AGENT_PORT=8888 AGENT_ALLOW_BEARER=0

EXPOSE 8888

# 健康检查打匿名 /healthz；host 网络下回环可达（若绑定到特定 IP 请相应调整）。
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request,sys; p=os.getenv('AGENT_PORT','8888'); sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/healthz'%p,timeout=4).status==200 else 1)"

# 单 worker、不加 --preload：避免多进程同改 iptables / DNS 刷新线程在 fork 后丢失。
# 用 sh -c 展开监听环境变量，同时让 Docker 的主进程 exec 为 gunicorn，正确接收停止信号。
CMD ["sh", "-c", "exec gunicorn --workers 1 --threads 4 --timeout 60 --bind ${AGENT_HOST}:${AGENT_PORT} --access-logfile - wsgi:app"]
