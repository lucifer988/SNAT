FROM python:3.11-slim

WORKDIR /app

# 固定依赖版本（requirements.txt），保证可复现构建
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# 保留 web/ 目录结构，gunicorn web.wsgi:app 能识别 blueprint 子包
COPY web /app/web

ENV APP_ENV=production FORCE_HTTPS=0 TRUST_PROXY=0 \
    SNAT_DB_FILE=/data/snat_manager.db SNAT_SECRET_KEY_FILE=/data/secret_key \
    SNAT_LOG_FILE=/data/logs/snat_web.log BACKUP_DIR=/data/backups \
    WEB_HOST=0.0.0.0 WEB_PORT=5000

RUN addgroup --gid 10001 snat && adduser --uid 10001 --gid 10001 --disabled-password --gecos '' --home /app snat \
    && mkdir -p /data/logs /data/backups \
    && chown -R snat:snat /app /data

EXPOSE 5000

# 容器健康检查：/healthz 匿名探针，且 before_request 对该路径放行 HTTPS 强制，HTTP 可达。
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:5000/healthz',timeout=4).status==200 else 1)"

# 单 worker + 多线程：进程内内存态（登录锁定/限流/日志缓冲）要求不分裂进程。
USER snat
CMD ["sh", "-c", "exec gunicorn --workers 1 --threads 8 --timeout 60 --bind 0.0.0.0:5000 --access-logfile - web.wsgi:app"]
